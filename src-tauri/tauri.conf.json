{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Omoio",
  "version": "0.1.0",
  "identifier": "com.omoio.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Omoio",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 600,
        "decorations": false,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Omoio",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU3RjQxMDM4M0VBODlDQjcKUldTM25LZytPQkQwVjk5MGdTbGpCRjFaMlgxMWYzOHROcFNmbjJITVNPeGdYdVVlVkg0aDEyeWcK",
      "endpoints": [
        "https://github.com/Bertrram/omoio/releases/latest/download/latest.json"
      ]
    }
  }
}
